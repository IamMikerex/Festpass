APP_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=festpass
DB_PASSWORD=festpass
DB_NAME=festpass
# Festival local time (Europe/Istanbul); NOW()/CURDATE() in rules use it
DB_TIMEZONE=+03:00
# Long random string in production: python -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_HOURS=8
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
CORS_ORIGIN=http://localhost:5173
# Order expiry, fee deadline and lifecycle jobs; 0 disables them
JOBS_INTERVAL_SECONDS=30
