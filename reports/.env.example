# Must point at the same MySQL database as the Express API
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=festpass
DB_PASSWORD=festpass
DB_NAME=festpass
DB_TIMEZONE=+03:00
# Must be identical to JWT_SECRET in server/.env (tokens issued by Express are verified here)
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:5173
