PORT=4000
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=festpass
DB_PASSWORD=festpass
DB_NAME=festpass
# Festival local time (Europe/Istanbul). Used for NOW()/CURDATE() in rules.
DB_TIMEZONE=+03:00
# Use a long random string in production: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
CORS_ORIGIN=http://localhost:5173
JOBS_INTERVAL_MS=30000
