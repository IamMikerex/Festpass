{
  "name": "festpass-server",
  "version": "1.0.0",
  "description": "FestPass REST API (Node.js + Express + MySQL 8)",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:init": "node scripts/initDb.js",
    "db:schema": "node scripts/initDb.js --schema-only",
    "test": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.21.2",
    "express-rate-limit": "7.4.1",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "morgan": "1.10.0",
    "mysql2": "3.11.5",
    "zod": "3.23.8"
  }
}
