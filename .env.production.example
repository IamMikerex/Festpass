# FestPass production settings for docker-compose.prod.yml.
# cp .env.production.example .env.production  and replace every value marked CHANGE.
# Generate secrets with:  openssl rand -hex 32
# Never commit .env.production.

# Public address of the site (used for CORS). With --profile https: https://<DOMAIN>
PUBLIC_URL=http://localhost:8080

# --- MySQL (letters and digits only) ---
MYSQL_ROOT_PASSWORD=CHANGE-root-password
DB_MIGRATE_PASSWORD=CHANGE-migrate-password
DB_APP_PASSWORD=CHANGE-app-password
DB_ANALYTICS_PASSWORD=CHANGE-analytics-password
DB_TIMEZONE=+03:00

# --- Secrets (at least 32 random characters each) ---
JWT_SECRET=CHANGE-me-to-64-hex-characters-from-openssl-rand
PAYMENT_WEBHOOK_SECRET=CHANGE-me-to-64-hex-characters-from-openssl-rand
JWT_EXPIRES_IN=8h

# --- Web server ---
# Without Caddy the site is on http://HTTP_BIND:HTTP_PORT. 127.0.0.1 keeps it private behind your own proxy;
# use 0.0.0.0 to expose it directly (e.g. a classroom LAN).
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# With --profile https: the domain name Caddy gets a certificate for
DOMAIN=festpass.example.com

# --- Data ---
# true = load the demo festivals and accounts on first start (for a class demo). Keep false for real use.
SEED_DEMO=false

# --- Tuning (optional) ---
DB_CONNECTION_LIMIT=15
ANALYTICS_WORKERS=2
JOBS_INTERVAL_MS=30000
LOG_LEVEL=info
ANALYTICS_DOCS=true
